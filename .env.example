# Shopify Storefront API — use the private token from Admin → Headless → your storefront
# Domain must be *.myshopify.com only (no https://). Custom domains will not work here.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Optional; default 2024-10 (set 2025-01 if your store supports it)
# SHOPIFY_STOREFRONT_API_VERSION=2024-10

# Admin API — required for live box counters + leaderboards (orders/paid webhook updates)
# Same custom app → Admin API access token with: read_orders, write_orders, read_products, write_products
SHOPIFY_ADMIN_ACCESS_TOKEN=
# SHOPIFY_ADMIN_API_VERSION=2024-10

# Webhook signing secret from Shopify Admin → Settings → Notifications → Webhooks
# (or the secret shown when you create the orders/paid webhook)
# Required for auto boxes_sold / leaderboard updates.
# Endpoint MUST be: https://YOUR_DOMAIN/api/webhooks/shopify/orders-paid
# Topic MUST be: orders/paid (Order payment)
SHOPIFY_WEBHOOK_SECRET=

# Optional secret for POST /api/admin/fundraising/replay-order (Bearer token).
# Use to diagnose / manually apply a paid order when the webhook missed it.
# FUNDRAISING_ADMIN_SECRET=

# Comma-separated collection handles for /fundraisers (public main directory).
# Each listed collection automatically gets a boxes-sold counter + leaderboard.
# Placeholder handles below will show nothing until you replace them with real handles from Shopify.
SHOPIFY_FUNDRAISER_COLLECTION_HANDLES=bags-of-groceries

# Queensland campaigns (same Shopify collection + metafield setup as public campaigns).
# Listed only at /qld/fundraisers — never linked from header, footer, or homepage.
# Share that URL privately; it is not indexed in the main site navigation.
# SHOPIFY_FUNDRAISER_COLLECTION_HANDLES_QLD=brisbane-school-fete

# Private-by-link campaigns (schools, clubs, etc. — not on the public site).
# One URL per handle only: /p/{handle} — there is no /p directory listing.
# Same Shopify collection + metafield setup; add handles here and redeploy.
# SHOPIFY_FUNDRAISER_COLLECTION_HANDLES_PRIVATE=school-athletics-2026,local-netball-club

# Set to true to list up to 48 collections from Shopify when handles are wrong or unset (handy for testing).
# SHOPIFY_FUNDRAISER_LIST_ALL_COLLECTIONS=true

# Site-wide $500 cash giveaway (cumulative: every 5 boxes across any fundraiser = 1 entry).
# Shows a sliding banner on fundraiser campaign/product pages and /cart.
# GIVEAWAY_ENABLED=true

# Resend — fundraising enquiry emails (https://resend.com). Required in production.
RESEND_API_KEY=

# Inbound address for enquiry notifications (defaults to Sunny@sunnysdonuts.com.au if unset in code).
ENQUIRY_TO_EMAIL=Sunny@sunnysdonuts.com.au

# Sender shown on emails. Trial: use Resend’s onboarding address, e.g.:
# RESEND_FROM=Sunny's Donuts Enquiries <onboarding@resend.dev>
# After you verify a domain in Resend, switch to your domain.
RESEND_FROM=Sunny's Donuts Enquiries <onboarding@resend.dev>
